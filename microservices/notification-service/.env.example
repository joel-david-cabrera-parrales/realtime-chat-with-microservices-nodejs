TORM_HOST_DB=postgres
TORM_PORT_DB=5432
TORM_USER_DB=change_me_user
TORM_PASSWORD_DB=change_me_password
TORM_NAME_DB=change_me_db

PORT=3000

JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_SALT_ROUNDS=10

INTERNAL_API_KEY=change_me_internal_api_key

HTTP_CLIENT_BASE_URL=http://user-profile-service:3000/api/profile
HTTP_CLIENT_TIMEOUT_MS=15000

ALLOWED_ORIGINS=*

# KAFKA
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service
KAFKA_TOPICS=chat.auth.session.created,chat.auth.session.revoked
KAFKA_FROM_BEGINNING=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_RETRY_BASE_DELAY_MS=1000
KAFKA_RETRY_MAX_DELAY_MS=30000

# MAILER
MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_SECURE=true
MAILER_USER=your-email@example.com
MAILER_SECRET=your-smtp-app-password
MAILER_FROM=your-email@example.com
MAILER_TIMEOUT_MS=10000
