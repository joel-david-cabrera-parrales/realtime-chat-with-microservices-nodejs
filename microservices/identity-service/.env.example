TORM_HOST_DB=postgres
TORM_PORT_DB=5432
TORM_USER_DB=change_me_user
TORM_PASSWORD_DB=change_me_password
TORM_NAME_DB=change_me_db

PORT=3000

JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_SALT_ROUNDS=10

SESSION_TTL_SECONDS=86400

PROFILE_SERVICE_URL=http://user-profile-service:3000/api/profile

INTERNAL_API_KEY=change_me_internal_api_key

KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=identity-service
KAFKA_SOURCE=identity-service
KAFKA_TOPIC_PREFIX=chat.auth
KAFKA_CONNECT_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_BUFFER_MAX=1000
KAFKA_RETRY_BASE_DELAY_MS=1000
KAFKA_RETRY_MAX_DELAY_MS=30000
