# ==========================================
# Variables de entorno del frontend (Zenith Chat)
# ==========================================
# Copia este archivo como .env:
#   cp .env.example .env

# Base URL de la API (pasa por el API Gateway nginx en el puerto 80)
VITE_API_BASE_URL=http://localhost

# Nombre de la app (se muestra en el layout de auth)
VITE_APP_NAME=Zenith Chat
