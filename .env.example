# ==========================================
# Variables del stack (docker compose)
# ==========================================
# Copia este archivo como .env en la raiz del repositorio:
#   cp .env.example .env
# Docker Compose lee este archivo automaticamente para resolver ${VARIABLES}.

# --- Postgres (superusuario) ---
DB_USER=postgres
DB_PASSWORD=change_me_password
DB_DATABASE=main_db

# --- Postgres (usuario por microservicio) ---
# init-scripts/01-init-databases.sh crea un usuario y una base por servicio.
# Estas passwords deben coincidir con TORM_PASSWORD_DB del .env de cada servicio.
AUTH_DB_PASSWORD=change_me_password
PROFILE_DB_PASSWORD=change_me_password
CHAT_DB_PASSWORD=change_me_password
STORAGE_DB_PASSWORD=change_me_password
NOTIFICATION_DB_PASSWORD=change_me_password

# --- pgadmin (opcional, viene comentado en docker-compose.yml) ---
PG_ADMIN_EMAIL=change_me_email
PGADMIN_PASSWORD=change_me_password

# --- AWS / LocalStack (S3 compatible en desarrollo) ---
AWS_LOCAL_TOKEN=change_me_localstack_token
AWS_REGION=us-east-1
AWS_STORAGE_SERVICE=s3
AWS_STORAGE_SERVICE_PORT=4568
AWS_S3_ENDPOINT=http://localhost:4568
AWS_S3_BUCKET=chat-bucket-local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Kafka (desarrollo local, modo KRaft de un solo nodo) ---
KAFKA_EXTERNAL_PORT=9093
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=INTERNAL://:29092,EXTERNAL://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:29092,EXTERNAL://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# ==========================================
# Variables compartidas por los microservicios
# ==========================================
# Cada microservicio tiene su propio .env (copia de su .env.example).
# El JWT_SECRET debe ser IDENTICO en todos: es lo que permite que el token
# emitido por identity-service lo verifique el resto de servicios.
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_SALT_ROUNDS=10

SESSION_TTL_SECONDS=86400

INTERNAL_API_KEY=change_me_internal_api_key

# Claves de Kafka usadas por identity-service (publica) y notification-service (consume)
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=identity-service
KAFKA_SOURCE=identity-service
KAFKA_TOPIC_PREFIX=chat.auth
KAFKA_CONNECT_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_BUFFER_MAX=1000
KAFKA_RETRY_BASE_DELAY_MS=1000
KAFKA_RETRY_MAX_DELAY_MS=30000
